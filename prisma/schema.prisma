generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        String   @id @default(cuid())
  username  String
  email     String   @unique
  password  String
  salt      String
  role      String   @default("User")
  sessionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
